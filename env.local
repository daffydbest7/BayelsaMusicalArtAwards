EMAIL_PROVIDER_API_KEY=

# ── Hidden admin path ─────────────────────────────────────────
# This is NOT a placeholder to fill in later — generate it now, before the
# first prompt, so it exists from the very first commit and is never sitting
# in git history as "/admin" even briefly.
#
# Generate one with:
#   node -e "console.log('ops-' + require('crypto').randomBytes(6).toString('hex'))"
# or in a terminal:
#   echo "ops-$(openssl rand -hex 6)"
#
# Example of the FORMAT only (do not reuse this exact value):
#   ADMIN_BASE_PATH=ops-rqidqoaf0h
#
# Treat this string itself as a secret — same handling as a password.
ADMIN_BASE_PATH=ops-2c874a318808

# ── Bot verification ──────────────────────────────────────────
# Choose ONE mode and set BOT_VERIFY_PROVIDER to match:
#   "turnstile" — dash.cloudflare.com → Turnstile → Add site (Managed challenge)
#   "hcaptcha"  — dashboard.hcaptcha.com → Sites → New site
#   "none"      — NO external dashboard/account needed at all. Uses a
#                 built-in honeypot field + submission-timing check instead.
#                 Real fallback, not a stub — safe to launch with if neither
#                 dashboard above is reachable. Upgradeable later with zero
#                 code changes outside lib/bot-verify.ts.
BOT_VERIFY_PROVIDER=turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAD6C75ZMSvEQ_3nL
TURNSTILE_SECRET_KEY=0x4AAAAAAD6C709PjRXQszvF5GSt9_ocAus
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
# Leave all four keys above blank if BOT_VERIFY_PROVIDER=none.
